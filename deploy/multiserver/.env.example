# Settings of the multiserver setup; copy to .env (gitignored). This is the ONLY file you edit: config.yml takes all
# of it from the environment, so it never needs local changes and "git pull" always works. Values here are the defaults.
# Site specific values: CHANGE the first three on a server.
SM_SESSION_KEY=devkey
SM_ADMIN_PASSWORD=admin
# Public URL of the web UI incl. the published port, e.g. https://acsm.example.com or http://203.0.113.10:8772
SM_BASE_URL=http://localhost:8772

# Published ports; passed into the container and set as the ports of the servers (config.yml, servers[].ports), they
# are not set in "Server Options". If SM_WEB_PORT changes, change SM_BASE_URL too (without a reverse proxy).
SM_WEB_PORT=8772
# Address the web UI is published on. 127.0.0.1 behind a reverse proxy on the host (see README.md, "Behind a reverse proxy").
SM_WEB_BIND=0.0.0.0
SERVER_A_PORT=9600
SERVER_A_HTTP_PORT=8081
SERVER_B_PORT=9601
SERVER_B_HTTP_PORT=8082
# Content Manager wrapper (TCP) of each server; the port is fixed here, the wrapper is switched on or off in "Server Options".
SERVER_A_CM_PORT=8101
SERVER_B_CM_PORT=8102

# Optional third server, see README.md "Adding and removing servers":
# SERVER_C_PORT=9602
# SERVER_C_HTTP_PORT=8083
# SERVER_C_CM_PORT=8103
