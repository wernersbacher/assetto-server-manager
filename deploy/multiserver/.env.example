# Published ports of the multiserver setup; copy to .env (gitignored). The values here are the defaults.
# The acServer ports must also be set in "Server Options" of each server. If SM_WEB_PORT changes, change
# server_manager_base_URL in config.yml too.
SM_WEB_PORT=8772
SERVER_A_PORT=9600
SERVER_A_HTTP_PORT=8081
SERVER_B_PORT=9601
SERVER_B_HTTP_PORT=8082

# Optional third server, see README.md "Adding and removing servers":
# SERVER_C_PORT=9602
# SERVER_C_HTTP_PORT=8083
